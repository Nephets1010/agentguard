<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.nephets</groupId>
    <artifactId>agentguard</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>agentguard-contract</artifactId>
  <name>agentguard-contract</name>
  <description>公共契约：处置动作与严重级别枚举、命中记录与检查结果值对象、四类治理异常、工具风险等级与判定枚举。零依赖（不含 slf4j），供 core / policy / starter 共同引用。</description>

  <!--
    ★ 本模块零依赖：只有 JDK 21，连 slf4j 都不引。
      契约层是全部模块的地基，任何第三方依赖都会顺着依赖图污染上层模块。
  -->
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>**/package-info.java</exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <properties>
    <jacoco.report.skip>false</jacoco.report.skip>
  </properties>
</project>
