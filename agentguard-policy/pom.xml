<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.nephets</groupId>
    <artifactId>agentguard</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>agentguard-policy</artifactId>
  <name>agentguard-policy</name>
  <description>策略引擎与规则：工具治理三道闸（未注册拒绝 / 角色白名单 / 高危需审批）、参数规则校验、输入侧七类 guardrail 与输出侧 PII 脱敏 / schema 规则。规则实现 Guardrail SPI，由 core 的 GuardrailChain 编排。</description>

  <!--
    ★ 本模块严禁引入任何 org.springframework.* 依赖（CI 的 architecture-boundaries job 强制扫描）。
      规则只依赖契约值与 core 的编排接口，不感知 Spring。
  -->
  <dependencies>
    <dependency>
      <groupId>io.github.nephets</groupId>
      <artifactId>agentguard-contract</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.nephets</groupId>
      <artifactId>agentguard-core</artifactId>
    </dependency>
    <!-- 仅用 slf4j-api 接口做可观测日志，不引入任何 org.springframework.* 实现 -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>**/package-info.java</exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <properties>
    <jacoco.report.skip>false</jacoco.report.skip>
  </properties>
</project>
